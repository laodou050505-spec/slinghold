# Unity 生成 / 缓存（可由 Unity 重新生成）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/_Recovery/
/Assets/_Recovery.meta

# 打包产物（安装包放 Releases，不进仓库）
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab

# 美术原始素材：只收录公司标志原件和 P2 部件配置；
# 建模中间文件、参考图、贴图原稿、配音原声体积大且不参与打包，不入库（游戏用到的成品都在 Assets 里）
/ArtSource/*
!/ArtSource/Brand/
!/ArtSource/specs.json

# 文档：概念图是早期方向稿，不入库
/Docs/概念图/

# Python 缓存
__pycache__/
*.pyc

# IDE / 系统
.vs/
.idea/
.vscode/
*.csproj
*.sln
.DS_Store

# PICO SDK 许可证禁止分发：放在工程根目录 PICO-SDK/XR，不入库（见 README）
/PICO-SDK/
# 测试截图体积大，只在本机
/Docs/进度截图/
/Docs/音频试听/
